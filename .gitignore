# ============================================================
# SIH26151 / BharatCipher - Git Ignore
# ============================================================

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
ENV/

# Python tooling / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# Flask / Runtime
# -------------------------
instance/
*.log
flask_session/

# -------------------------
# SQLite databases
# -------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------
# Face-ID private/runtime data
# -------------------------
backend/data/face_data/
faceid/backend/data/face_data/

# -------------------------
# Frontend - Node
# -------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/

# npm logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# -------------------------
# Frontend environment
# -------------------------
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Keep development example config
!frontend/.env.example

# -------------------------
# OS generated files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# IDE / Editors
# -------------------------
.vscode/
.idea/
*.swp
*.swo

# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp
*.bak
*.backup
*.old

# -------------------------
# Test / generated output
# -------------------------
.pytest_cache/
.coverage
htmlcov/

# Generated intelligence outputs
intelligence/output/
intelligence/**/output/

# -------------------------
# Uploaded / local datasets
# -------------------------
# Uncomment these if datasets should stay local:
# intelligence/ingestion/data/
# intelligence/datasets/

# -------------------------
# Model weights
# -------------------------
# Uncomment if model files become large:
# *.onnx
# *.pth
# *.pt
# *.pkl
# *.joblib